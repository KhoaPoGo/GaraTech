	<classpathentry kind="lib" path="GaraTech/lib/flatlaf-fonts-inter-4.1.jar"/>
	<classpathentry kind="lib" path="GaraTech/lib/mssql-jdbc-12.8.1.jre11.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
